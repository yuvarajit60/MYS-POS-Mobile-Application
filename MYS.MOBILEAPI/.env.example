# Copy to ".env" and fill in real values. Never commit the real ".env" file.

# SQL Server connection string the cloud host will use. The current DB is a
# local SQLEXPRESS instance on this dev machine, which the cloud CANNOT
# reach — this must point to a database the cloud host can actually connect
# to (e.g. Azure SQL Database, or a cloud-reachable SQL Server instance).
CONNECTION_STRING=Server=<your-cloud-sql-host>;Database=db_ams_erp;User Id=<user>;Password=<password>;TrustServerCertificate=True;

# Any long random string (32+ chars). Generate one and keep it fixed —
# changing it invalidates every issued token and refresh token.
JWT_SIGNING_KEY=<generate-a-long-random-secret>

# Real SMS gateway credentials, once you have a working provider
# (sms.amseltechnologies.com is currently unreachable — see prior notes).
SMS_USERNAME=
SMS_PASSWORD=
